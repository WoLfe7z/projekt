// Shema baze za PrvihXI (docs/03-podatkovni-model.md)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vloga {
  menedzer
  urednik
  admin
}

model User {
  id            String    @id
  name          String    @map("ime")
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  vloga         Vloga     @default(menedzer)
  jeBlokiran    Boolean   @default(false) @map("je_blokiran")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  mostvo        Mostvo?

  @@map("uporabnik")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- klubi in nogometaši ----------

enum Pozicija {
  VR // vratar
  OB // branilec
  VE // vezist
  NA // napadalec
}

enum StatusNogometasa {
  na_voljo
  poskodovan
  kaznovan
}

model Klub {
  id             String      @id @default(uuid())
  naziv          String      @unique
  kratica        String      @unique
  nogometasi     Nogometas[]
  domaceTekme    Tekma[]     @relation("domaci")
  gostujoceTekme Tekma[]     @relation("gostje")

  @@map("klub")
}

model Nogometas {
  id        String            @id @default(uuid())
  klubId    String            @map("klub_id")
  klub      Klub              @relation(fields: [klubId], references: [id])
  ime       String
  priimek   String
  pozicija  Pozicija
  cena      Decimal           @db.Decimal(4, 1) // v mio, npr. 7.5
  status    StatusNogometasa  @default(na_voljo)
  zunanjiId Int?              @unique @map("zunanji_id") // ID v zunanjem API-ju
  mostva    MostvoNogometas[]
  postave   Postava[]

  @@index([klubId])
  @@map("nogometas")
}

// ---------- fantasy moštvo ----------

model Mostvo {
  id          String            @id @default(uuid())
  uporabnikId String            @unique @map("uporabnik_id") // en uporabnik ima največ eno moštvo
  uporabnik   User              @relation(fields: [uporabnikId], references: [id], onDelete: Cascade)
  ime         String
  proracun    Decimal           @default(100.0) @db.Decimal(4, 1) // preostanek proračuna v mio
  skupneTocke Int               @default(0) @map("skupne_tocke")
  createdAt   DateTime          @default(now())
  nogometasi  MostvoNogometas[]
  postave     Postava[]

  @@map("mostvo")
}

// vmesna tabela: 15 nogometašev v moštvu
model MostvoNogometas {
  mostvoId    String    @map("mostvo_id")
  nogometasId String    @map("nogometas_id")
  mostvo      Mostvo    @relation(fields: [mostvoId], references: [id], onDelete: Cascade)
  nogometas   Nogometas @relation(fields: [nogometasId], references: [id])

  @@id([mostvoId, nogometasId])
  @@index([nogometasId])
  @@map("mostvo_nogometas")
}

// ---------- krogi in tekme ----------

model Krog {
  id        String    @id @default(uuid())
  stevilka  Int       @unique // 1–36
  rok       DateTime // rok za spremembe postav: 1 ura pred prvo tekmo kroga
  obracunan Boolean   @default(false)
  tekme     Tekma[]
  postave   Postava[]

  @@map("krog")
}

enum StatusTekme {
  napovedana
  v_vnosu
  potrjena
}

model Tekma {
  id         String      @id @default(uuid())
  krogId     String      @map("krog_id")
  krog       Krog        @relation(fields: [krogId], references: [id])
  domaciId   String      @map("domaci_id")
  domaci     Klub        @relation("domaci", fields: [domaciId], references: [id])
  gostjeId   String      @map("gostje_id")
  gostje     Klub        @relation("gostje", fields: [gostjeId], references: [id])
  zacetek    DateTime
  goliDomaci Int?        @map("goli_domaci") // prazno, dokler urednik ne vnese rezultata
  goliGostje Int?        @map("goli_gostje")
  status     StatusTekme @default(napovedana)
  zunanjiId  Int?        @unique @map("zunanji_id") // ID v zunanjem API-ju

  @@index([krogId])
  @@map("tekma")
}

// ---------- postava za krog ----------

// en zapis na igralca: 15 zapisov na moštvo in krog
model Postava {
  id          String    @id @default(uuid())
  mostvoId    String    @map("mostvo_id")
  mostvo      Mostvo    @relation(fields: [mostvoId], references: [id], onDelete: Cascade)
  krogId      String    @map("krog_id")
  krog        Krog      @relation(fields: [krogId], references: [id])
  nogometasId String    @map("nogometas_id")
  nogometas   Nogometas @relation(fields: [nogometasId], references: [id])
  mesto       Int // 1–11 začetna postava, 12–15 klop po vrstnem redu menjav
  kapetan     Boolean   @default(false)
  tocke       Int? // izpolni obračun kroga

  @@unique([mostvoId, krogId, nogometasId]) // igralec je v postavi kroga samo enkrat
  @@unique([mostvoId, krogId, mesto]) // vsako mesto je zasedeno samo enkrat
  @@index([krogId])
  @@index([nogometasId])
  @@map("postava")
}
