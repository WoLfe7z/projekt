# Kopiraj to datoteko v .env:  cp .env.example .env

# Baza (isto kot v docker-compose.yml)
DATABASE_URL="postgresql://prvihxi:prvihxi@localhost:5432/prvihxi"

# Better Auth
BETTER_AUTH_SECRET="better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"

# E-pošta (Mailpit iz docker-compose.yml)
SMTP_URL="smtp://localhost:1025"

# API-Football (https://www.api-football.com)
API_FOOTBALL_KEY=""
